<div class="container">
        <h2 class="section-title">تشكيلة منتجاتنا</h2>
        
        <!-- شبكة المنتجات التي يتم تحميلها ديناميكياً من لوحة الأدمن -->
        <div class="products-grid" id="mainProductsGrid">
            <!-- سيتم تعبئة المنتجات تلقائياً هنا -->
        </div>
    </div>

    <!-- كود الجافاسكربت لجلب المنتجات وعرضها -->
    <script>
        // جلب المنتجات المخزنة من لوحة التحكم، أو عرض المنتجات الافتراضية إذا كانت فارغة
        let defaultProducts = [
            { name: "Mounia Gauf شوكولاتة", desc: "علبة تحتوي على كمية ممتازة من قوفريط منيا بنكهة الشوكولاتة الغنية والمقرمشة.", price: "متوفر جملة ونصف جملة" },
            { name: "Mounia Gauf فانيليا", desc: "قرمشة خفيفة وطعم الفانيليا الأصلي، مثالية لأصحاب الأكیوس والمحلات التجارية.", price: "متوفر جملة ونصف جملة" },
            { name: "Mounia Gauf بنكهة الموز", desc: "المذاق المحبوب لدى الأطفال والكبار، متوفر بكميات كبرى لتجار الجملة بأسعار تنافسية.", price: "متوفر جملة ونصف جملة" }
        ];

        let products = JSON.parse(localStorage.getItem('mouniaProducts')) || defaultProducts;
        
        const grid = document.getElementById('mainProductsGrid');
        grid.innerHTML = '';

        products.forEach(product => {
            grid.innerHTML += `
                <div class="card">
                    <div class="card-img">صورة ${product.name}</div>
                    <div class="card-body">
                        <span class="badge">جملة ونصف جملة</span>
                        <h3 class="card-title">${product.name}</h3>
                        <p class="card-text">${product.desc}</p>
                        <p style="color: #d9534f; font-weight: bold; margin-bottom: 1rem;">${product.price}</p>
                        <a href="https://wa.me/213000000000?text=أهلاً، أهتم بشراء ${encodeURIComponent(product.name)} بالجملة" class="btn" target="_blank">اطلب عبر واتساب</a>
                    </div>
                </div>
            `;
        });
    </script>
