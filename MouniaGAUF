            font-size: 0.95rem;
            margin-bottom: 1rem;
        }
        .badge {
            display: inline-block;
            background: #fff3cd;
            color: #856404;
            padding: 0.3rem 0.8rem;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1rem;
        }
        .btn {
            display: block;
            width: 100%;
            background: #28a745;
            color: white;
            text-align: center;
            padding: 0.75rem;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            transition: background 0.2s;
        }
        .btn:hover {
